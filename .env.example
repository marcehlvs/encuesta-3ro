# Copiá este archivo a .env y completá con los datos de TU proyecto de Firebase
# (Configuración del proyecto > Tus apps > Configuración del SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave de sitio de reCAPTCHA Enterprise (App Check). Opcional en desarrollo.
VITE_RECAPTCHA_SITE_KEY=

# Enlace corto público (para el QR del panel), p. ej. https://encuesta-3a.web.app
VITE_URL_PUBLICA=
